datasource db {
  provider = "postgresql"
  
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// All enums are defined here

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES_EXECUTIVE
  INVENTOR
  RESELLER
  USER
}

enum CommonStatus {
  ACTIVE
  DEACTIVATED
  PENDING
}

enum InventoryTxType {
  STOCK_IN
  STOCK_OUT
}

enum InventoryTxPurpose {
  SELL
  PURCHASE
  RETURN
  DAMAGE
}

enum PaymentStatus {
  DUE
  PAID
  PARTIAL
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BKASH
  NAGAD
  BANK_TRANSFER
}

enum OrderProcessingStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model User {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String       @db.VarChar(255)
  email              String       @unique @db.VarChar(255)
  phone              String       @unique @db.VarChar(20)
  secondaryPhone     String?      @db.VarChar(20)
  passwordHash       String       @map("password_hash") @db.VarChar(255)
  refreshTokenHash   String?      @map("refresh_token_hash") @db.Text
  refreshTokenExpiresAt DateTime?  @map("refresh_token_expires_at")
  role               UserRole      @default(USER)
  OrganizationId      String       @map("organization_id") @db.Uuid
  imageUrl           String?      @map("image_url") @db.Text
  status             CommonStatus @default(PENDING)
  pageName           String?      @unique @map("page_name") @db.VarChar(100)
  presentDistrict    String       @map("present_district") @db.VarChar(100)
  presentThana       String       @map("present_thana") @db.VarChar(100)
  permanentDistrict  String       @map("permanent_district") @db.VarChar(100)
  permanentThana     String       @map("permanent_thana") @db.VarChar(100)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  carts              Cart[]
  orders             Order[]

  @@map("user")
}

model Category {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(100)
  imageUrl  String       @map("image_url") @db.Text
  status    CommonStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  products  Product[]
  subcategories Subcategory[]

  @@map("category")
}

model Subcategory {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String         @db.VarChar(100)
  categoryId  String         @map("category_id") @db.Uuid
  status      CommonStatus   @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products    Product[]
  childCategories ChildCategory[]

  @@map("subcategory")
}

model ChildCategory {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String       @db.VarChar(100)
  subcategoryId String       @map("subcategory_id") @db.Uuid
  status        CommonStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  subcategory   Subcategory  @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  products      Product[]

  @@map("child_category")
}

model Brand {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(100)
  imageUrl  String       @map("image_url") @db.Text
  status    CommonStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  products  Product[]

  @@map("brand")
}

model Product {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String         @db.VarChar(255)
  categoryId        String         @map("category_id") @db.Uuid
  subcategoryId     String?        @map("subcategory_id") @db.Uuid
  childCategoryId   String?        @map("child_category_id") @db.Uuid
  brandId           String         @map("brand_id") @db.Uuid
  purchasePrice     Decimal        @map("purchase_price") @db.Decimal(12, 2)
  oldPrice          Decimal        @map("old_price") @db.Decimal(12, 2)
  newPrice          Decimal        @map("new_price") @db.Decimal(12, 2)
  resellerPrice     Decimal        @map("reseller_price") @db.Decimal(12, 2)
  videoUrl          String?        @map("video_url") @db.Text
  unit              String         @default("piece") @db.VarChar(50)
  description       String         @db.Text
  status            CommonStatus   @default(ACTIVE)
  showAsNewArrival  Boolean        @default(true) @map("show_as_new_arrival")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")
  
  category          Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory       Subcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  childCategory     ChildCategory? @relation(fields: [childCategoryId], references: [id], onDelete: SetNull)
  brand             Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  inventories       Inventory[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  images            ProductImage[]
  colors            ProductColor[]
  sizes             ProductSize[]
  ages              ProductAge[]

  @@map("product")
}

model ProductImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  imageUrl   String   @map("image_url") @db.Text
  isPrimary  Boolean  @default(false) @map("is_primary")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_image")
}

model Color {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String         @db.VarChar(50)
  colorCode String         @map("color_code") @db.VarChar(7)
  status    CommonStatus   @default(ACTIVE)
  products  ProductColor[]

  @@map("color")
}

model ProductColor {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String      @map("product_id") @db.Uuid
  colorId     String      @map("color_id") @db.Uuid
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color       Color       @relation(fields: [colorId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([productId, colorId])
  @@map("product_color_variant")
}

model Size {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @db.VarChar(50)
  status      CommonStatus  @default(ACTIVE)
  products    ProductSize[]

  @@map("size")
}

model ProductSize {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String      @map("product_id") @db.Uuid
  sizeId      String      @map("size_id") @db.Uuid
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size        Size        @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  inventories Inventory[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([productId, sizeId])
  @@map("product_size_variant")
}

model AgeVariant {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ageRange String       @map("age_range") @db.VarChar(50)
  status   CommonStatus @default(ACTIVE)
  products ProductAge[]

  @@map("age_variant")
}

model ProductAge {
  productId    String     @map("product_id") @db.Uuid
  ageVariantId String     @map("age_variant_id") @db.Uuid
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ageVariant   AgeVariant @relation(fields: [ageVariantId], references: [id], onDelete: Cascade)

  @@id([productId, ageVariantId])
  @@map("product_age_variant")
}

model Inventory {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String                 @map("product_id") @db.Uuid
  productSizeId    String?                @map("product_size_id") @db.Uuid
  currentStock     Int                    @default(0) @map("current_stock")
  costPerUnit      Decimal                @default(0) @map("cost_per_unit") @db.Decimal(12, 2)
  supplierName     String                 @map("supplier_name") @db.VarChar(255)
  supplierMobile   String                 @map("supplier_mobile") @db.VarChar(20)
  stockLimitAlert  Int                    @default(10) @map("stock_limit_alert")
  notes            String?                @db.Text
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSize      ProductSize?           @relation(fields: [productSizeId], references: [id], onDelete: Restrict)
  transactions     InventoryTransaction[]

  @@unique([productId, productSizeId])
  @@map("inventory")
}

model InventoryTransaction {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryId         String               @map("inventory_id") @db.Uuid
  transactionQuantity Int                  @map("transaction_quantity")
  stockBefore         Int                  @map("stock_before")
  stockAfter          Int                  @map("stock_after")
  stockType           InventoryTxType      @map("stock_type")
  purpose             InventoryTxPurpose
  reference           String?              @db.VarChar(100)
  performedBy         String               @map("performed_by") @db.Uuid
  notes               String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at")
  inventory           Inventory            @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@map("inventory_transaction")
}

model Cart {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  promoCode      String?      @map("promo_code") @db.VarChar(50)
  courierCharge  Decimal      @default(0.00) @map("courier_charge") @db.Decimal(12, 2)
  total          Decimal      @default(0.00) @db.Decimal(12, 2)
  notes          String?      @db.Text
  status         String       @default("active") @db.VarChar(20)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  customer       User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orders         Order[]

  @@map("cart")
}

model CartItem {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId         String        @map("cart_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  productSizeId  String?       @map("product_size_id") @db.Uuid
  productColorId String?       @map("product_color_id") @db.Uuid
  quantity       Int           @default(1)
  unitPrice      Decimal       @map("unit_price") @db.Decimal(12, 2)
  subtotal       Decimal       @map("subtotal") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  cart           Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSize    ProductSize?  @relation(fields: [productSizeId], references: [id], onDelete: SetNull)
  productColor   ProductColor? @relation(fields: [productColorId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, productSizeId, productColorId])
  @@map("cart_item")
}

model Order {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId             String                @map("cart_id") @db.Uuid
  customerId         String                @map("customer_id") @db.Uuid
  paymentStatus      PaymentStatus         @default(DUE) @map("payment_status")
  paymentMethod      PaymentMethod         @map("payment_method")
  processingStatus   OrderProcessingStatus @default(PENDING) @map("processing_status")
  orderProcessedBy   String?               @map("order_processed_by") @db.Uuid
  subtotal           Decimal               @default(0.00) @db.Decimal(12, 2)
  courierCharge      Decimal               @default(0.00) @map("courier_charge") @db.Decimal(12, 2)
  discount           Decimal               @default(0.00) @db.Decimal(12, 2)
  total              Decimal               @default(0.00) @db.Decimal(12, 2)
  shippingAddress    String?               @map("shipping_address") @db.Text
  notes              String?               @db.Text
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  cart               Cart                  @relation(fields: [cartId], references: [id], onDelete: Restrict)
  customer           User                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderItems         OrderItem[]

  @@map("order")
}

model OrderItem {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  productSizeId  String?       @map("product_size_id") @db.Uuid
  productColorId String?       @map("product_color_id") @db.Uuid
  quantity       Int
  snapshotPrice  Decimal       @map("snapshot_price") @db.Decimal(12, 2)
  subtotal       Decimal       @map("subtotal") @db.Decimal(12, 2)

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSize    ProductSize?  @relation(fields: [productSizeId], references: [id], onDelete: Restrict)
  productColor   ProductColor? @relation(fields: [productColorId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId, productSizeId, productColorId])
  @@index([productId])
  @@map("order_item")
}

model CmsSocialMedia {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(100)
  iconName  String       @map("icon_name") @db.VarChar(100)
  status    CommonStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("cms_social_media")
}

model CmsContact {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String       @db.VarChar(20)
  email     String       @db.VarChar(255)
  address   String       @db.Text
  telegram  String?      @db.VarChar(255)
  whatsapp  String?      @db.VarChar(255)
  facebook  String?      @db.VarChar(255)
  status    CommonStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("cms_contact")
}

model CmsHero {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  heroTitle    String       @map("hero_title") @db.VarChar(255)
  heroSubtitle String       @map("hero_subtitle") @db.Text
  buttonText1  String       @map("button_text_1") @db.VarChar(50)
  buttonLink1  String       @map("button_link_1") @db.Text
  buttonText2  String?      @map("button_text_2") @db.VarChar(50)
  buttonLink2  String?      @map("button_link_2") @db.Text
  imageUrl     String       @map("image_url") @db.Text
  status       CommonStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("cms_hero")
}

model CmsAbout {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(255)
  description String       @db.Text
  youtubeLink String       @map("youtube_link") @db.Text
  buttonText1 String       @map("button_text_1") @db.VarChar(50)
  buttonLink1 String       @map("button_link_1") @db.Text
  buttonText2 String?      @map("button_text_2") @db.VarChar(50)
  buttonLink2 String?      @map("button_link_2") @db.Text
  status      CommonStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("cms_about")
}

model CmsSection {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String       @db.VarChar(255)
  description     String       @db.Text
  imageUrl        String?    @map("image_url") @db.Text
  cardTitle       String       @map("card_title") @db.VarChar(255)
  cardIcon        String       @map("card_icon") @db.VarChar(100)
  cardDescription String       @map("card_description") @db.Text
  cardButton      String?      @map("card_button") @db.VarChar(50)
  cardLink        String?      @map("card_link") @db.Text
  status          CommonStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("cms_section")
}

model CmsFounder {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(255)
  description String       @db.Text
  imageUrl    String       @map("image_url") @db.Text
  status      CommonStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("cms_founder")
}

model CmsFounderBlog {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(255)
  imageUrl    String       @map("image_url") @db.Text
  description String       @db.Text
  status      CommonStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("cms_founder_blog")
}

model CmsFounderVideo {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(255)
  videoLink   String       @map("video_link") @db.Text
  description String       @db.Text
  status      CommonStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("cms_founder_video")
}

