{
  "info": {
    "name": "Aarham API - POST/PATCH/DELETE (MySQL)",
    "description": "Write-request checks against the MySQL-backed API: create, update and delete across categories, products, inventory, cart and orders, including automatic restock on admin cancel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": { "exec": [
        "if (!pm.collectionVariables.get('run')) {",
        "  const ts = String(Date.now());",
        "  pm.collectionVariables.set('run', ts.slice(-6));",
        "  pm.collectionVariables.set('custEmail', `postman${ts.slice(-6)}@test.local`);",
        "  pm.collectionVariables.set('custPhone', `017${ts.slice(-8)}`);",
        "}"
      ] }
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "POST login as admin",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/login", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\" }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 + access token', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().accessToken).to.be.a('string'); });",
            "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
          ] } }]
        },
        {
          "name": "GET admin profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const me = pm.response.json(); pm.collectionVariables.set('adminId', me.id || me.sub);"
          ] } }]
        }
      ]
    },
    {
      "name": "Category",
      "item": [
        {
          "name": "POST create category",
          "request": { "method": "POST", "url": "{{baseUrl}}/categories", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Postman Shirts {{run}}\", \"imageUrl\": \"https://placehold.co/300.png\" }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "const b = pm.response.json();",
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('id is a UUID generated by Prisma (CHAR(36))', () => pm.expect(b.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/));",
            "pm.test('defaults applied (status ACTIVE, timestamps)', () => { pm.expect(b.status).to.eql('ACTIVE'); pm.expect(b.createdAt).to.be.a('string'); });",
            "pm.collectionVariables.set('categoryId', b.id);"
          ] } }]
        },
        {
          "name": "PATCH rename category",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/categories/{{categoryId}}", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Postman Shirts {{run}} (Renamed)\", \"status\": \"PENDING\" }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('name and status updated', () => { const b = pm.response.json(); pm.expect(b.name).to.include('(Renamed)'); pm.expect(b.status).to.eql('PENDING'); });"
          ] } }]
        },
        {
          "name": "GET category persisted after PATCH",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories/{{categoryId}}", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 and change is stored in MySQL', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().name).to.include('(Renamed)'); });"
          ] } }]
        },
        {
          "name": "POST throwaway category",
          "request": { "method": "POST", "url": "{{baseUrl}}/categories", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Delete Me {{run}}\", \"imageUrl\": \"x\" }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('tempCategoryId', pm.response.json().id);"
          ] } }]
        },
        {
          "name": "DELETE throwaway category",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/categories/{{tempCategoryId}}", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('soft delete: status becomes DEACTIVATED', () => pm.expect(pm.response.json().status).to.eql('DEACTIVATED'));"
          ] } }]
        },
        {
          "name": "GET deleted category is kept but deactivated",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories/{{tempCategoryId}}", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 and DEACTIVATED is stored in MySQL', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('DEACTIVATED'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "Product",
      "item": [
        {
          "name": "POST brand (setup)",
          "request": { "method": "POST", "url": "{{baseUrl}}/brands", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Postman Brand {{run}}\", \"imageUrl\": \"x\" }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201)); pm.collectionVariables.set('brandId', pm.response.json().id);"
          ] } }]
        },
        {
          "name": "POST size (setup)",
          "request": { "method": "POST", "url": "{{baseUrl}}/sizes", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"XL-{{run}}\" }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201)); pm.collectionVariables.set('sizeId', pm.response.json().id);"
          ] } }]
        },
        {
          "name": "POST color (setup)",
          "request": { "method": "POST", "url": "{{baseUrl}}/colors", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Teal {{run}}\", \"colorCode\": \"#008080\" }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201)); pm.collectionVariables.set('colorId', pm.response.json().id);"
          ] } }]
        },
        {
          "name": "POST create product with images, size and color",
          "request": { "method": "POST", "url": "{{baseUrl}}/products", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Polo {{run}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"brandId\": \"{{brandId}}\",\n  \"purchasePrice\": 450.50,\n  \"oldPrice\": 1200,\n  \"newPrice\": 999,\n  \"resellerPrice\": 700,\n  \"description\": \"Created from Postman\",\n  \"images\": [{ \"imageUrl\": \"https://placehold.co/600.png\", \"isPrimary\": true }, { \"imageUrl\": \"https://placehold.co/601.png\" }],\n  \"sizeIds\": [\"{{sizeId}}\"],\n  \"colorIds\": [\"{{colorId}}\"],\n  \"supplierName\": \"Dhaka Textiles\",\n  \"supplierMobile\": \"01711111111\"\n}" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('productId', pm.response.json().id);"
          ] } }]
        },
        {
          "name": "GET product detail (relations + decimals)",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "const p = pm.response.json();",
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('2 images, 1 size, 1 color saved', () => { pm.expect(p.images).to.have.length(2); pm.expect(p.sizes).to.have.length(1); pm.expect(p.colors).to.have.length(1); });",
            "pm.test('DECIMAL(12,2) keeps cents', () => pm.expect(Number(p.purchasePrice)).to.eql(450.5));",
            "pm.collectionVariables.set('productSizeId', p.sizes[0].id); pm.collectionVariables.set('productColorId', p.colors[0].id);"
          ] } }]
        },
        {
          "name": "PATCH product price and name",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/products/{{productId}}", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Postman Polo {{run}} v2\", \"newPrice\": 899 }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('price and name updated', () => { const b = pm.response.json(); pm.expect(Number(b.newPrice)).to.eql(899); pm.expect(b.name).to.include('v2'); });"
          ] } }]
        },
        {
          "name": "POST stock in 10 units",
          "request": { "method": "POST", "url": "{{baseUrl}}/inventory/adjust", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"productId\": \"{{productId}}\", \"productSizeId\": \"{{productSizeId}}\", \"transactionQuantity\": 10, \"stockType\": \"STOCK_IN\", \"purpose\": \"PURCHASE\", \"performedBy\": \"{{adminId}}\" }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 and stock 0 -> 10', () => { pm.response.to.have.status(201); const b = pm.response.json(); pm.expect(b.stockBefore).to.eql(0); pm.expect(b.stockAfter).to.eql(10); });"
          ] } }]
        }
      ]
    },
    {
      "name": "Cart (customer)",
      "item": [
        {
          "name": "POST register customer",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/register", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Postman Customer\", \"email\": \"{{custEmail}}\", \"phone\": \"{{custPhone}}\", \"password\": \"Customer#123\", \"role\": \"USER\", \"organizationId\": \"00000000-0000-0000-0000-000000000000\", \"presentDistrict\": \"Dhaka\", \"presentThana\": \"Mirpur\", \"permanentDistrict\": \"Dhaka\", \"permanentThana\": \"Mirpur\" }" } },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('201', () => pm.response.to.have.status(201));" ] } }]
        },
        {
          "name": "POST login as customer",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/login", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"email\": \"{{custEmail}}\", \"password\": \"Customer#123\" }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201)); pm.collectionVariables.set('custToken', pm.response.json().accessToken);"
          ] } }]
        },
        {
          "name": "POST add 2 to cart",
          "request": { "method": "POST", "url": "{{baseUrl}}/cart/items", "header": [{ "key": "Authorization", "value": "Bearer {{custToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"productId\": \"{{productId}}\", \"productSizeId\": \"{{productSizeId}}\", \"productColorId\": \"{{productColorId}}\", \"quantity\": 2 }" } },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('201', () => pm.response.to.have.status(201));" ] } }]
        },
        {
          "name": "GET cart (capture item id)",
          "request": { "method": "GET", "url": "{{baseUrl}}/cart", "header": [{ "key": "Authorization", "value": "Bearer {{custToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "const c = pm.response.json();",
            "pm.test('1 line, qty 2, subtotal 2 x 899', () => { pm.expect(c.cartItems).to.have.length(1); pm.expect(c.cartItems[0].quantity).to.eql(2); pm.expect(Number(c.cartItems[0].subtotal)).to.eql(1798); });",
            "pm.collectionVariables.set('cartItemId', c.cartItems[0].id);"
          ] } }]
        },
        {
          "name": "PATCH cart item quantity to 3",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/cart/items/{{cartItemId}}", "header": [{ "key": "Authorization", "value": "Bearer {{custToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"quantity\": 3 }" } },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('200 OK', () => pm.response.to.have.status(200));" ] } }]
        },
        {
          "name": "GET cart after PATCH",
          "request": { "method": "GET", "url": "{{baseUrl}}/cart", "header": [{ "key": "Authorization", "value": "Bearer {{custToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "const c = pm.response.json();",
            "pm.test('qty 3, subtotal and cart total recalculated', () => { pm.expect(c.cartItems[0].quantity).to.eql(3); pm.expect(Number(c.cartItems[0].subtotal)).to.eql(2697); pm.expect(Number(c.total)).to.eql(2697); });"
          ] } }]
        },
        {
          "name": "DELETE cart item",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/cart/items/{{cartItemId}}", "header": [{ "key": "Authorization", "value": "Bearer {{custToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('200 OK', () => pm.response.to.have.status(200));" ] } }]
        },
        {
          "name": "GET cart is empty after DELETE",
          "request": { "method": "GET", "url": "{{baseUrl}}/cart", "header": [{ "key": "Authorization", "value": "Bearer {{custToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('no items left, total 0', () => { const c = pm.response.json(); pm.expect(c.cartItems || []).to.have.length(0); pm.expect(Number(c.total || 0)).to.eql(0); });"
          ] } }]
        }
      ]
    },
    {
      "name": "Order + cancel restock",
      "item": [
        {
          "name": "POST add 4 to cart",
          "request": { "method": "POST", "url": "{{baseUrl}}/cart/items", "header": [{ "key": "Authorization", "value": "Bearer {{custToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"productId\": \"{{productId}}\", \"productSizeId\": \"{{productSizeId}}\", \"productColorId\": \"{{productColorId}}\", \"quantity\": 4 }" } },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('201', () => pm.response.to.have.status(201));" ] } }]
        },
        {
          "name": "POST place order",
          "request": { "method": "POST", "url": "{{baseUrl}}/orders", "header": [{ "key": "Authorization", "value": "Bearer {{custToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"paymentMethod\": \"CASH_ON_DELIVERY\", \"shippingAddress\": \"House 1, Mirpur, Dhaka\", \"courierCharge\": 60 }" } },
          "event": [{ "listen": "test", "script": { "exec": [
            "const o = pm.response.json();",
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('total = 4 x 899 + 60', () => pm.expect(Number(o.total)).to.eql(3656));",
            "pm.collectionVariables.set('orderId', o.id);"
          ] } }]
        },
        {
          "name": "GET stock after order (10 - 4 = 6)",
          "request": { "method": "GET", "url": "{{baseUrl}}/inventory/product/{{productId}}", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json(); const rows = Array.isArray(j) ? j : (j.data || [j]);",
            "const inv = rows.find(r => r.productSizeId === pm.collectionVariables.get('productSizeId'));",
            "pm.test('stock is 6', () => pm.expect(inv.currentStock).to.eql(6));"
          ] } }]
        },
        {
          "name": "PATCH admin cancel order",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/orders/{{orderId}}/cancel", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "const o = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('order marked cancelled', () => { pm.expect(o.processingStatus).to.eql('CANCELLED'); pm.expect(o.paymentStatus).to.eql('CANCELLED'); pm.expect(o.courierStatus).to.eql('cancelled'); });"
          ] } }]
        },
        {
          "name": "GET stock restored after cancel (back to 10)",
          "request": { "method": "GET", "url": "{{baseUrl}}/inventory/product/{{productId}}", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "const j = pm.response.json(); const rows = Array.isArray(j) ? j : (j.data || [j]);",
            "const inv = rows.find(r => r.productSizeId === pm.collectionVariables.get('productSizeId'));",
            "pm.test('stock is back to 10', () => pm.expect(inv.currentStock).to.eql(10));"
          ] } }]
        },
        {
          "name": "PATCH cancel again is refused",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/orders/{{orderId}}/cancel", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 already cancelled', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().message).to.include('already cancelled'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "Delete product",
      "item": [
        {
          "name": "DELETE product (soft delete)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/products/{{productId}}", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('deletedAt is set', () => pm.expect(pm.response.json().deletedAt).to.be.a('string'));"
          ] } }]
        },
        {
          "name": "GET deleted product returns 404",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('404 Not Found', () => pm.response.to.have.status(404));" ] } }]
        },
        {
          "name": "DELETE category that still has a product",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/categories/{{categoryId}}", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200, soft delete so no foreign-key error', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('DEACTIVATED'); });"
          ] } }]
        }
      ]
    }
  ]
}
