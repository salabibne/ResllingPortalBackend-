# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# MySQL / MariaDB. Local development: docker compose up -d (phpMyAdmin on http://localhost:8080)
# URL-encode special characters in the password (e.g. @ -> %40).
# Shared hosting (cPanel): enable "Remote MySQL" for the backend server IP.
DATABASE_URL="mysql://aarham:aarham@localhost:3306/aarham_apparel"

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
# Render injects PORT automatically; only needed for local runs.
PORT=3000

# Allowed CORS origin (frontend URL). Comma-free single origin.
FRONTEND_URL="http://localhost:4000"

# ------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------
ACCESS_TOKEN_SECRET="change_me_access_token_secret"
REFRESH_TOKEN_SECRET="change_me_refresh_token_secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ------------------------------------------------------------------
# Steadfast Courier API
# ------------------------------------------------------------------
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"
STEADFAST_HTTP_TIMEOUT_MS="10000"
